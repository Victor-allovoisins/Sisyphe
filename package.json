{
  "name": "sisyphe",
  "version": "0.1.0",
  "description": "Daemon qui transforme des issues GitHub en pull requests via un agent Claude",
  "type": "module",
  "bin": {
    "sisyphe": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "picomatch": "^4.0.7",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
